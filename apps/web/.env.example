# =============================================================================
# Frontend Next.js Configuration (apps/web)
# =============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=changeme-generate-a-random-secret-at-least-32-chars

# Zitadel Authentication (OIDC / OAuth 2.0)
# Example Cloud: https://<instance-domain>.zitadel.cloud
# Example Self-hosted: http://localhost:8080
ZITADEL_ISSUER=https://<your-instance>.zitadel.cloud
ZITADEL_CLIENT_ID=<your-zitadel-client-id>
ZITADEL_CLIENT_SECRET=<your-zitadel-client-secret>

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile Bot Protection
# Testing sitekeys: 1x00000000000000000000AA (Always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
