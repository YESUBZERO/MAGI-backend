{
  "name": "aires-magi",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"turbo -F web dev\" \"bash scripts/native/task-1.sh\"",
    "dev:all": "concurrently --kill-others \"turbo -F web dev\" \"cd apps/server && go run cmd/all/main.go\"",
    "dev:worker": "cd apps/server && go run cmd/worker/main.go",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "bash scripts/native/task-1.sh",
    "setup:server": "bash scripts/native/task-2.sh",
    "check:server": "bash scripts/native/task-3.sh",
    "test:server": "cd apps/server && go test -v ./...",
    "test:web": "bun run --filter web test",
    "test": "bun run test:web && bun run test:server",
    "setup:part:backend:go:gin": "bash scripts/native/task-2.sh",
    "dev:part:backend:go:gin": "bash scripts/native/task-1.sh",
    "check:part:backend:go:gin": "bash scripts/native/task-3.sh",
    "test:part:backend:go:gin": "bash scripts/native/task-3.sh"
  },
  "dependencies": {
    "@aires-magi/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aires-magi/config": "workspace:*",
    "@types/bun": "catalog:",
    "concurrently": "^9.2.1",
    "turbo": "2.10.11",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
